{
  "name": "command-table",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/server/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "backup": "node scripts/backup.mjs",
    "format": "prettier --write .",
    "test:container": "node scripts/container-smoke.mjs mtg-util:local",
    "test:proxy": "node scripts/proxy-smoke.mjs",
    "test:pwa": "node scripts/pwa-smoke.mjs",
    "test:lan": "node scripts/lan-smoke.mjs",
    "measure:performance": "node scripts/measure-performance.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@fastify/websocket": "11.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.4",
    "idb": "8.0.3",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1"
  },
  "description": "A mobile-friendly Magic life counter for one device or shared rooms, with commander damage, 3D dice, and recoverable games.",
  "author": "Addison16",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Addison16/commanders-table.git"
  },
  "homepage": "https://github.com/Addison16/commanders-table#readme",
  "bugs": {
    "url": "https://github.com/Addison16/commanders-table/issues"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
