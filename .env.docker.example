# Copy this file to .env beside compose.yaml for a first installation.
# Keep your existing .env, Compose project and data volume when updating.
# Set this to the exact address that every phone will open.
PUBLIC_ORIGIN=http://192.168.1.50:8080
ALLOW_INSECURE_HTTP=true

# latest follows stable releases; use a published version or digest to pin.
# After a backup: docker compose -p mtg-util -f compose.yaml pull
# Then apply it: docker compose -p mtg-util -f compose.yaml up -d
# Pulling alone does not update a running container.
MTG_IMAGE=ghcr.io/addison16/commandtable:latest

# For HTTPS behind one reverse proxy, use these settings instead:
# PUBLIC_ORIGIN=https://table.example.com
# ALLOW_INSECURE_HTTP=false
# TRUST_PROXY_HOPS=1
TRUST_PROXY_HOPS=0
ROOM_TTL_DAYS=30
SESSION_TTL_DAYS=90

# Shared command budgets apply across tabs and transports.
MAX_CONNECTIONS=512
MAX_ROOM_CONNECTIONS=64
ROOM_RECEIPT_LIMIT=20000
RETRY_REVISION_WINDOW=10000

# Verified automatic SQLite backups; retain the latest 14 scheduled copies.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
# Optional second destination: configure BACKUP_COPY_DIR in Compose and mount
# a separate disk/remote filesystem there. The default volume is local only.
